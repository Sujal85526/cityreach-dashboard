# Local development runs against the Firebase emulators (no real project needed).
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-digital-manager
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-digital-manager.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
# Optional: set to true only if pages load forever on your network (forces long polling).
# VITE_FIRESTORE_LONG_POLLING=true
