{
  "name": "digital-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Digital Manager: staff, attendance, tasks and inventory management for small coffee shops",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dm/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "seed": "pnpm --filter @dm/tools seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:rules": "pnpm --filter @dm/tools test:rules",
    "test:flows": "pnpm --filter @dm/web test:flows",
    "indexes:wait": "pnpm --filter @dm/tools indexes:wait"
  },
  "devDependencies": {
    "firebase-tools": "^15.31.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
