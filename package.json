{
  "name": "cityreach-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "City Reach: staff, attendance, tasks and inventory dashboard. A local demo, no backend.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cityreach/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
